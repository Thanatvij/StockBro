# คัดลอกไฟล์นี้ไปเป็น .github/workflows/daily.yml (Claude เขียนลงโฟลเดอร์ .github ผ่านเครื่องมือไม่ได้ ต้องสร้างเอง)
# ก่อนใช้: ตั้ง secrets ที่ GitHub → Settings → Secrets and variables → Actions
#   STOCKBRO_SEC_UA                          เช่น "ชื่อ-นามสกุล อีเมล" (SEC บังคับให้ระบุตัวตนเวลาเรียก)
#   STOCKBRO_SMTP_USER / STOCKBRO_SMTP_PASS  อีเมลผู้ส่ง + Gmail App Password (ถ้าไม่อยากส่งอีเมล ลบ step "Send email" ได้)
#   STOCKBRO_MAIL_TO                         ผู้รับ คั่นด้วยจุลภาค (ไม่ตั้ง = ส่งเข้าอีเมลผู้ส่งเอง)
name: daily-brief
on:
  schedule:
    - cron: "30 12 * * 1-5"   # 19:30 น. เวลาไทย จันทร์-ศุกร์
  workflow_dispatch: {}
permissions:
  contents: write
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: Test
        working-directory: services
        run: python -m unittest discover -s tests -t .
      - name: Build brief
        working-directory: services
        env:
          STOCKBRO_SEC_UA: ${{ secrets.STOCKBRO_SEC_UA }}
        run: python -m stockbro_engine.run
      - name: Commit results
        run: |
          git config user.name "stockbro-bot"
          git config user.email "stockbro-bot@users.noreply.github.com"
          git add site/data data/stockbro.db
          git diff --staged --quiet || git commit -m "daily brief $(date -u +%F)"
          git push
      - name: Send email
        continue-on-error: true   # ส่งไม่สำเร็จก็ไม่ทำให้ขั้นตอนอื่นล้ม
        working-directory: services
        env:
          STOCKBRO_SMTP_USER: ${{ secrets.STOCKBRO_SMTP_USER }}
          STOCKBRO_SMTP_PASS: ${{ secrets.STOCKBRO_SMTP_PASS }}
          STOCKBRO_MAIL_TO: ${{ secrets.STOCKBRO_MAIL_TO }}
        run: python -m stockbro_engine.mail
